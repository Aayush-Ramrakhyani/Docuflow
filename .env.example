# ── DocuFlow Environment Configuration ──────────────────────────────────────
# Copy this file to .env and fill in all values.
# NEVER commit .env to version control.

# ── App ──────────────────────────────────────────────────────────────────────
SECRET_KEY=generate-a-secure-random-key-at-least-32-chars
ENVIRONMENT=development   # development | staging | production
DEBUG=true

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://docuflow:docuflow@localhost:5432/docuflow

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── Storage ───────────────────────────────────────────────────────────────────
# For MinIO (local dev):
STORAGE_BACKEND=minio
S3_ENDPOINT_URL=http://localhost:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_DOCUMENTS=docuflow-documents
S3_BUCKET_EXPORTS=docuflow-exports

# For AWS S3 (production):
# STORAGE_BACKEND=s3
# S3_ENDPOINT_URL=
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_REGION=us-east-1

# ── AI Providers ──────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated allowed origins
ALLOWED_ORIGINS=http://localhost:5173

# ── Email (optional for now) ──────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@docuflow.app
